# ============================================================
# Luxy AI — Environment Configuration
# Copy to .env and fill in your values. NEVER commit .env.
# ============================================================

# --- Runtime mode ---
# DRY_RUN=true  -> every trade is simulated end-to-end (safe, no funds needed)
# DRY_RUN=false -> real execution (requires funded wallets + live API keys)
DRY_RUN=true
LOG_LEVEL=info

# Paper portfolio size used for dry-run risk checks and PnL accounting
PAPER_PORTFOLIO_USD=2500

# --- LLM: Tier 1 — Luxy Core (high-stakes decisions) ---
# provider: anthropic | openai | openrouter | local
LUXY_LLM_PROVIDER=anthropic
LUXY_LLM_API_KEY=
LUXY_LLM_MODEL=claude-sonnet-5
# Only used when LUXY_LLM_PROVIDER=local (vLLM / Ollama OpenAI-compatible endpoint)
LUXY_LLM_BASE_URL=http://localhost:8000/v1

# --- LLM: Tier 2 — Sub-agents (high-volume, low-stakes) ---
SUBAGENT_LLM_PROVIDER=openrouter
SUBAGENT_LLM_API_KEY=
SUBAGENT_LLM_MODEL=deepseek/deepseek-chat-v3-0324

# --- E2B sandbox terminal (optional in dry-run; TS backtest fallback is used without it) ---
E2B_API_KEY=

# --- Data layer ---
DATABASE_URL=postgresql://luxy:luxy_dev_password@localhost:5432/luxydb
REDIS_URL=redis://localhost:6379

# --- Solana data providers ---
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HELIUS_API_KEY=
BIRDEYE_API_KEY=

# --- Jupiter (swap routing; free, no auth) ---
JUPITER_API_BASE=https://quote-api.jup.ag/v6

# --- Hyperliquid perps ---
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WALLET_ADDRESS=
HYPERLIQUID_PRIVATE_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: separate token for the narrative channel monitor (avoids getUpdates conflicts)
NARRATIVE_TELEGRAM_BOT_TOKEN=
NARRATIVE_TELEGRAM_CHANNELS=

# --- Reddit (narrative agent) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=luxy-ai-narrative-agent/0.1 (by u/mrxpoint)

# --- Risk management (hardcoded at executor layer; the LLM cannot override) ---
RISK_MAX_POSITION_PCT=0.03
RISK_MAX_DAILY_DRAWDOWN_PCT=0.08
RISK_MAX_SLIPPAGE_PCT=0.02
RISK_MAX_CONCURRENT_POSITIONS=5

# --- Screener cadence (minutes) ---
SCREENER_INTERVAL_MIN=5
PERPS_INTERVAL_MIN=15
LP_HUNTER_INTERVAL_MIN=30
LP_HEALER_INTERVAL_MIN=10
NARRATIVE_INTERVAL_MIN=20
