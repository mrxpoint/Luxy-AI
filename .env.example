# ============================================================
# Luxy AI — Environment Configuration
# Copy to .env and fill in your values. NEVER commit .env.
# ============================================================

# --- Runtime mode ---
# DRY_RUN=true  -> every trade is simulated end-to-end (safe, no funds needed)
# DRY_RUN=false -> real execution (requires funded wallets + live API keys)
DRY_RUN=true
LOG_LEVEL=info

# Paper portfolio size used for dry-run risk checks and PnL accounting
PAPER_PORTFOLIO_USD=2500

# --- LLM: Tier 1 — Luxy Core (high-stakes decisions) ---
# provider: anthropic | openai | openrouter | local
LUXY_LLM_PROVIDER=anthropic
LUXY_LLM_API_KEY=
LUXY_LLM_MODEL=claude-sonnet-5
# Only used when LUXY_LLM_PROVIDER=local (vLLM / Ollama OpenAI-compatible endpoint)
LUXY_LLM_BASE_URL=http://localhost:8000/v1

# --- LLM: Tier 2 — Sub-agents (high-volume, low-stakes) ---
SUBAGENT_LLM_PROVIDER=openrouter
SUBAGENT_LLM_API_KEY=
SUBAGENT_LLM_MODEL=deepseek/deepseek-chat-v3-0324

# --- E2B sandbox terminal (optional in dry-run; TS backtest fallback is used without it) ---
E2B_API_KEY=

# --- Data layer ---
DATABASE_URL=postgresql://luxy:luxy_dev_password@localhost:5432/luxydb
REDIS_URL=redis://localhost:6379

# --- Solana data providers ---
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HELIUS_API_KEY=
BIRDEYE_API_KEY=

# --- Jupiter (swap routing; free, no auth) ---
JUPITER_API_BASE=https://quote-api.jup.ag/v6

# --- Hyperliquid perps ---
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WALLET_ADDRESS=
HYPERLIQUID_PRIVATE_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: separate token for the narrative channel monitor (avoids getUpdates conflicts)
NARRATIVE_TELEGRAM_BOT_TOKEN=
NARRATIVE_TELEGRAM_CHANNELS=

# --- Reddit (narrative agent) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=luxy-ai-narrative-agent/0.1 (by u/mrxpoint)

# --- Risk management (hardcoded at executor layer; the LLM cannot override) ---
RISK_MAX_POSITION_PCT=0.03
RISK_MAX_DAILY_DRAWDOWN_PCT=0.08
RISK_MAX_SLIPPAGE_PCT=0.02
RISK_MAX_CONCURRENT_POSITIONS=5

# --- Screener cadence (minutes) ---
SCREENER_INTERVAL_MIN=5
PERPS_INTERVAL_MIN=15
LP_HUNTER_INTERVAL_MIN=30
LP_HEALER_INTERVAL_MIN=10
NARRATIVE_INTERVAL_MIN=20

# --- EVM (Phase 3 — Base / Ethereum) ---
BASE_RPC_URL=https://mainnet.base.org
ETHEREUM_RPC_URL=https://eth.llamarpc.com
# Private key of the trading EOA — REQUIRED only for LIVE execution; leave
# empty in dry-run. The executor never auto-approves token allowances.
EVM_EXECUTOR_PRIVATE_KEY=
# Uniswap v3 subgraph endpoints (The Graph)
UNISWAP_SUBGRAPH_ETH=https://api.thegraph.com/subgraphs/name/uniswap/uniswap-v3
UNISWAP_SUBGRAPH_BASE=https://api.thegraph.com/subgraphs/name/uniswap/uniswap-v3
# Enable the Uniswap v3 Hunter/Healer loops inside the LP agent
LP_EVM_ENABLED=false
# Gas guard: skip EVM rebalances when gas cost exceeds this or the fee gain
EVM_GAS_COST_CEIL_USD=1.5
# SwapRouter02 for Base must be set explicitly before LIVE EVM execution
BASE_SWAP_ROUTER_02=

# --- Polymarket (Phase 3 — CLOB on Polygon) ---
POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API=https://clob.polymarket.com
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
# LLM-vs-market minimum edge to consider an order (0.08 = 8 cents)
POLYMARKET_MIN_EDGE=0.08

# --- Robinhood Crypto (Phase 3 — US crypto markets) ---
ROBINHOOD_API_BASE=https://trading.robinhood.com
ROBINHOOD_API_KEY=
# Ed25519 private key (base64 DER, pkcs8) registered with Robinhood
ROBINHOOD_PRIVATE_KEY_B64=

# --- TimescaleDB candle ingest (Phase 4) ---
CANDLES_INTERVAL_MIN=5
CANDLES_BACKFILL_HOURS=48

# --- Strategy self-tuning cadence (Phase 3, BLUEPRINT §5.3) ---
STRATEGY_TUNE_INTERVAL_MIN=60
